plugins {
	id 'java'
	id 'org.springframework.boot' version '3.5.7'
	id 'io.spring.dependency-management' version '1.1.7'
}

group = 'com.example'
version = '0.0.1-SNAPSHOT'
description = 'Demo project for Spring Boot'

java {
	toolchain {
		languageVersion = JavaLanguageVersion.of(17)
	}
}

configurations {
	compileOnly {
		extendsFrom annotationProcessor
	}
}

repositories {
	mavenCentral()
}

dependencies {

    // ✅ [Spring Boot 기본 웹 기능]
    // REST API, Controller, JSON 응답 등을 위한 웹 모듈
    implementation 'org.springframework.boot:spring-boot-starter-web'

    // ✅ [JPA (데이터베이스 ORM)]
    // Entity 관리 및 DB 접근 (MySQL, H2 등)
    implementation 'org.springframework.boot:spring-boot-starter-data-jpa'

    // ✅ [Thymeleaf]
    // 서버에서 HTML 템플릿 렌더링 (뷰 페이지)
    implementation 'org.springframework.boot:spring-boot-starter-thymeleaf'

    // ✅ [WebSocket]
    // 서버 ↔ 클라이언트 간 실시간 통신 (채팅 등)
    implementation 'org.springframework.boot:spring-boot-starter-websocket'

    implementation 'mysql:mysql-connector-j:8.0.33'

    // ✅ [Lombok]
    // Getter/Setter/Builder 등 자동 생성 (코드 간결화)
    implementation 'org.projectlombok:lombok'
    compileOnly 'org.projectlombok:lombok'
    annotationProcessor 'org.projectlombok:lombok'

    // ✅ [Test 환경]
    // JUnit 기반 단위 테스트 실행
    testImplementation 'org.springframework.boot:spring-boot-starter-test'

    // ✅ [Spring Security]
    // 로그인/인증/인가 기능 (JWT 인증 처리에 사용)
    implementation 'org.springframework.boot:spring-boot-starter-security'

    // ✅ [JWT (JSON Web Token)]
    // 로그인 토큰 발급, 검증 등 인증 로직 구현용
    implementation 'io.jsonwebtoken:jjwt-api:0.11.5'
    runtimeOnly 'io.jsonwebtoken:jjwt-impl:0.11.5'
    runtimeOnly 'io.jsonwebtoken:jjwt-jackson:0.11.5'
}

tasks.named('test') {
	useJUnitPlatform()
}
